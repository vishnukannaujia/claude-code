From a104cce3c9d5c714b9d57c83fb52cded920dce2e Mon Sep 17 00:00:00 2001
From: Vishnu Kannaujia <vishnu.kannaujia@gmail.com>
Date: Thu, 11 Jun 2026 09:02:17 +0000
Subject: [PATCH] Raise when an explicitly requested LoadImage reader is
 unavailable

Previously LoadImage(reader='ITKReader') with itk uninstalled would only
warn and silently fall back to a default reader, hiding the
misconfiguration. This change raises OptionalImportError immediately when
an explicitly-named reader cannot be instantiated due to a missing
optional dependency. The default auto-registration loop for SUPPORTED_READERS
is unchanged: it still logs quietly and continues.

Fixes #7437.

Signed-off-by: Vishnu Kannaujia <vishnu.kannaujia@gmail.com>
---
 monai/transforms/io/array.py                  | 10 ++--
 .../test_load_image_missing_reader.py         | 58 +++++++++++++++++++
 2 files changed, 64 insertions(+), 4 deletions(-)
 create mode 100644 tests/transforms/test_load_image_missing_reader.py

diff --git a/monai/transforms/io/array.py b/monai/transforms/io/array.py
index aadd967..c8c88ec 100644
--- a/monai/transforms/io/array.py
+++ b/monai/transforms/io/array.py
@@ -209,10 +209,12 @@ class LoadImage(Transform):
                     the_reader = look_up_option(_r.lower(), SUPPORTED_READERS)
                 try:
                     self.register(the_reader(*args, **kwargs))
-                except OptionalImportError:
-                    warnings.warn(
-                        f"required package for reader {_r} is not installed, or the version doesn't match requirement."
-                    )
+                except OptionalImportError as e:
+                    raise OptionalImportError(
+                        f"The requested reader `{_r}` requires an optional package which is not installed, "
+                        f"or the version doesn't match the requirement. Please install it, "
+                        f"or pass an available reader."
+                    ) from e
                 except TypeError:  # the reader doesn't have the corresponding args/kwargs
                     warnings.warn(f"{_r} is not supported with the given parameters {args} {kwargs}.")
                     self.register(the_reader())
diff --git a/tests/transforms/test_load_image_missing_reader.py b/tests/transforms/test_load_image_missing_reader.py
new file mode 100644
index 0000000..7474241
--- /dev/null
+++ b/tests/transforms/test_load_image_missing_reader.py
@@ -0,0 +1,58 @@
