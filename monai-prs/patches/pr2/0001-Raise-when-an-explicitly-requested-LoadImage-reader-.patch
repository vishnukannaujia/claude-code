+from __future__ import annotations
+
+import unittest
+
+import monai.transforms.io.array as array_module
+from monai.transforms import LoadImage
+from monai.utils import OptionalImportError
+
+_FAKE_READER_KEY = "fakemissingreader"
+
+
+class _FakeMissingReader:
+    def __init__(self, *args, **kwargs):
+        raise OptionalImportError("fake missing optional package")
+
+    def verify_suffix(self, *args, **kwargs):
+        return True
+
+    def read(self, *args, **kwargs):
+        pass
+
+    def get_data(self, *args, **kwargs):
+        pass
+
+
+class TestLoadImageMissingReader(unittest.TestCase):
+    def setUp(self):
+        self._original = dict(array_module.SUPPORTED_READERS)
+        array_module.SUPPORTED_READERS[_FAKE_READER_KEY] = _FakeMissingReader
+
+    def tearDown(self):
+        array_module.SUPPORTED_READERS.clear()
+        array_module.SUPPORTED_READERS.update(self._original)
+
+    def test_explicit_string_reader_raises(self):
+        with self.assertRaises(OptionalImportError) as cm:
+            LoadImage(reader=_FAKE_READER_KEY)
+        msg = str(cm.exception)
+        self.assertIn("optional package", msg)
+
+    def test_default_reader_does_not_raise(self):
+        loader = LoadImage()
+        self.assertIsNotNone(loader)
+
+
+if __name__ == "__main__":
+    unittest.main()
